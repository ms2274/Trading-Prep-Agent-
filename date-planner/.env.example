# Copy this file to `.env.local` (which is gitignored) and fill in what
# you have. The app runs end-to-end with everything unset — those pieces
# just fall back to demo/mock behavior.

# --- Anthropic (Claude) -----------------------------------------------------
# When set, "why we picked this" blurbs and vibe tags on each stop card are
# written by Claude instead of the deterministic mock generator.
# Get one from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Google Places (server-side) --------------------------------------------
# When set, venue search + travel times use live Google Places (New) and
# Distance Matrix instead of the bundled sample dataset.
# Enable these APIs in your Google Cloud project:
#   - Places API (New)
#   - Distance Matrix API
GOOGLE_PLACES_API_KEY=

# --- Google Maps (client-side, browser-exposed) -----------------------------
# When set, the itinerary detail view shows an interactive Google Map with
# the route drawn between stops. Restrict this key to your domain in
# Google Cloud console — the browser sees it.
# Enable: Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
