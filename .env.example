# Copy to .env.local and fill in. .env.local is gitignored — it never leaves your Mac.

# Polygon.io (now Massive.com) Stocks Starter plan API key
POLYGON_API_KEY=

# Financial Modeling Prep API key (free tier) — used for VIX quote
FMP_API_KEY=

# Anthropic API key
ANTHROPIC_API_KEY=

# Supabase project URL and service_role key (server-side only, never exposed to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
